REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# Client onboarding portal (a SEPARATE Supabase project and deployment).
# Only used by the Client Packages tab, which is shown to users flagged
# is_sales_rep on user_profiles.
REACT_APP_CLIENT_PORTAL_URL=https://clients.integratedstaffing.ca

# staff-api handoff endpoint on the client portal project. Trades a rep's
# Integrated Launch session for a one-time portal sign-in link, so they never
# keep a second password. Leave blank to link straight to the portal's own
# sign-in page instead.
REACT_APP_CLIENT_PORTAL_STAFF_API=https://<portal-project-ref>.supabase.co/functions/v1/staff-api
